# Copy to .env.local to change a setting; src/lib/env/schema.ts validates them for
# dev and build. VITE_ values ship in the client bundle, so never put secrets here.

# "authentik" when the backend has Authentik OIDC sign-in configured; the sign-in
# page then offers Continue with Authentik. The local Compose stack sets it.
# VITE_FILEBONSAI_OIDC=authentik

# Not a VITE_ setting: the dev server proxies /api and the OIDC paths to this
# backend origin (default http://127.0.0.1:8080).
# FILEBONSAI_API_PROXY_TARGET=http://127.0.0.1:8081
