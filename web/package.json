{
  "name": "@filebonsai/web-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "generate:schema": "openapi-typescript ../backend/contract/openapi.json -o src/lib/api/generated/schema.ts",
    "test": "node --import tsx --test src/lib/api/filebonsai-service.test.ts app/features/catalog/catalog-data.test.ts app/features/transfers/transfer-store.test.ts app/features/storage/storage-data.test.ts",
    "typecheck:run": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@tanstack/react-form": "1.33.5",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0",
    "isbot": "5.2.2"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.0.3"
  }
}
