  "components" : {
    "schemas" : {
      "AccessCsrfResponse" : {
        "required" : [ "headerName", "token" ],
        "type" : "object",
        "properties" : {
          "headerName" : {
            "type" : "string",
            "example" : "X-CSRF-TOKEN"
          },
          "token" : {
            "type" : "string"
          }
        }
      },
      "AccessLoginRequest" : {
        "required" : [ "password" ],
        "type" : "object",
        "properties" : {
          "password" : {
            "maxLength" : 1024,
            "minLength" : 1,
            "pattern" : "^[\\s\\S]*\\S[\\s\\S]*$",
            "type" : "string",
            "description" : "Contains at least one non-whitespace character",
            "writeOnly" : true
          }
        }
      },
      "AccessSessionResponse" : {
        "required" : [ "expiresAt", "principalId" ],
        "type" : "object",
        "properties" : {
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "principalId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "ApiErrorResponse" : {
        "required" : [ "code", "fieldErrors", "message", "requestId", "status" ],
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Open string, not an enum. Known codes are documented per operation. Fall back to status and message for unknown codes."
          },
          "fieldErrors" : {
            "type" : "array",
            "description" : "Empty when no individual field is responsible",
            "items" : {
              "$ref" : "#/components/schemas/FieldErrorResponse"
            }
          },
          "message" : {
            "type" : "string"
          },
          "requestId" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "BeginUploadRequest" : {
        "required" : [ "name", "parentId", "sizeBytes" ],
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "description" : "Logical filename; never used as a storage path"
          },
          "parentId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "sha256" : {
            "pattern" : "^[0-9a-fA-F]{64}$",
            "type" : "string",
            "description" : "Optional expected SHA-256 as 64 hexadecimal characters",
            "nullable" : true
          },
          "sizeBytes" : {
            "pattern" : "0|[1-9][0-9]*",
            "type" : "string",
            "description" : "Exact decimal byte count, up to the configured upload limit"
          }
        }
      },
      "CreateFolderRequest" : {
        "required" : [ "name", "parentId" ],
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "description" : "NFC normalized before comparison. Case-sensitive, no trimming. 1–255 normalized UTF-8 bytes; excludes dot names, separators and controls."
          },
          "parentId" : {
            "type" : "string",
            "description" : "Explicit containing folder ID, including for root children",
            "format" : "uuid"
          }
        }
      },
      "CurrentVersionResponse" : {
        "required" : [ "id", "sizeBytes" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "sizeBytes" : {
            "maxLength" : 19,
            "pattern" : "^(0|[1-9][0-9]{0,18})$",
            "type" : "string",
            "description" : "Base-10 byte count, 0 through 9223372036854775807 inclusive. Never a JSON number.",
            "example" : "9007199254740993"
          }
        }
      },
      "EntryPageResponse" : {
        "required" : [ "entries", "nextCursor" ],
        "type" : "object",
        "properties" : {
          "entries" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EntryResponse"
            }
          },
          "nextCursor" : {
            "type" : "string",
            "description" : "Opaque continuation token; null means end of this traversal",
            "nullable" : true
          }
        }
      },
      "EntryResponse" : {
        "type" : "object",
        "discriminator" : {
          "mapping" : {
            "file" : "#/components/schemas/FileEntryResponse",
            "folder" : "#/components/schemas/FolderEntryResponse"
          },
          "propertyName" : "kind"
        },
        "oneOf" : [ {
          "$ref" : "#/components/schemas/FileEntryResponse"
        }, {
          "$ref" : "#/components/schemas/FolderEntryResponse"
        } ]
      },
      "FieldErrorResponse" : {
        "required" : [ "code", "field", "message" ],
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Open string code; clients must allow unknown codes"
          },
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "description" : "Empty when no individual field is responsible"
      },
      "FileEntryResponse" : {
        "required" : [ "createdAt", "currentVersion", "id", "kind", "name", "parentId", "updatedAt" ],
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "currentVersion" : {
            "$ref" : "#/components/schemas/CurrentVersionResponse"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "file" ]
          },
          "name" : {
            "type" : "string",
            "description" : "NFC normalized; case preserved; maximum 255 UTF-8 bytes"
          },
          "parentId" : {
            "type" : "string",
            "description" : "Containing folder identity",
            "format" : "uuid"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "FolderEntryResponse" : {
        "required" : [ "createdAt", "id", "kind", "name", "parentId", "updatedAt" ],
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "folder" ]
          },
          "name" : {
            "type" : "string",
            "description" : "NFC normalized; case preserved; maximum 255 UTF-8 bytes"
          },
          "parentId" : {
            "type" : "string",
            "description" : "Null only for the workspace root",
            "format" : "uuid",
            "nullable" : true
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "StorageCapabilitiesResponse" : {
        "required" : [ "rangeDownloads", "resumableUploads", "sha256Verification" ],
        "type" : "object",
        "properties" : {
          "rangeDownloads" : {
            "type" : "boolean",
            "description" : "False means downloads always send the whole original."
          },
          "resumableUploads" : {
            "type" : "boolean",
            "description" : "False means an interrupted upload is sent again from byte zero."
          },
          "sha256Verification" : {
            "type" : "boolean",
            "description" : "True means every upload's size and SHA-256 are verified before the file becomes available."
          }
        }
      },
      "StorageConnectionResponse" : {
        "required" : [ "displayName", "providerKind" ],
        "type" : "object",
        "properties" : {
          "displayName" : {
            "maxLength" : 80,
            "type" : "string",
            "description" : "Operator-chosen name, or the provider's default. Never a bucket, account, endpoint, or path."
          },
          "providerKind" : {
            "type" : "string",
            "description" : "Open vocabulary; known values are local and r2. Clients must show an unknown value rather than fail.",
            "example" : "local"
          }
        }
      },
      "StorageSummaryResponse" : {
        "required" : [ "capabilities", "connection", "usedBytes" ],
        "type" : "object",
        "properties" : {
          "capabilities" : {
            "$ref" : "#/components/schemas/StorageCapabilitiesResponse"
          },
          "connection" : {
            "$ref" : "#/components/schemas/StorageConnectionResponse"
          },
          "usedBytes" : {
            "pattern" : "^(0|[1-9][0-9]*)$",
            "type" : "string",
            "description" : "Exact decimal sum of committed file versions in this workspace. Uploads that are not yet available are excluded."
          }
        }
      },
      "UploadLimitsResponse" : {
        "required" : [ "maximumBytes" ],
        "type" : "object",
        "properties" : {
          "maximumBytes" : {
            "pattern" : "^(0|[1-9][0-9]*)$",
            "type" : "string",
            "description" : "Largest accepted file size as an exact decimal byte count. Clients may reject larger files before beginning an upload; the server still enforces the limit."
          }
        }
      },
      "UploadResponse" : {
        "required" : [ "computedSha256", "entryId", "expectedSha256", "expiresAt", "id", "name", "parentId", "sizeBytes", "state", "versionId" ],
        "type" : "object",
        "properties" : {
          "computedSha256" : {
            "type" : "string",
            "nullable" : true
          },
          "entryId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "expectedSha256" : {
            "type" : "string",
            "nullable" : true
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "parentId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "sizeBytes" : {
            "pattern" : "0|[1-9][0-9]*",
            "type" : "string"
          },
          "state" : {
            "type" : "string",
            "description" : "Versioned closed lifecycle vocabulary; adding a value is a breaking API change.",
            "enum" : [ "INITIATED", "RECEIVING", "STAGED", "FINALIZING", "RECONCILING", "AVAILABLE", "CANCELLED", "EXPIRED", "FAILED" ]
          },
          "versionId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      }
    },
    "securitySchemes" : {
      "sessionCookie" : {
        "in" : "cookie",
        "name" : "FILEBONSAI_SESSION",
        "type" : "apiKey"
      }
    }
  }
}
